# Portas expostas no host (escolhidas para não conflitar com o SoftcomShop)
WEB_PORT=5180
API_PORT=8090
DB_PORT_HOST=3310

# Nome da rede do docker do SoftcomShop (docker network ls) - usado só pelo docker-compose.softcomshop.yml
SOFTCOMSHOP_NETWORK=softcomshop_default

# Gerador de Product Backlog - chave da API do Claude (https://console.anthropic.com).
# Sem chave o sistema monta o prompt para você colar no Claude e importar a resposta.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Porta do servidor MCP de demonstração (docker compose --profile demo up -d)
MCP_DEMO_PORT=8765
